/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "315348c9-1572-4014-927f-ab09722a5e54",
			"remote": true,
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "35c83956bd194e7f85313cc0555f61da",
			"remote": true,
		},
	],
	"queues": {
		"consumers": [
			{
				"queue": "smart-links-data-queue-stage",
				"dead_letter_queue": "smart-links-dead-letter-queue-stage",
			},
			{
				"queue": "smart-links-dead-letter-queue-stage",
				"retry_delay": 0,
			},
		],
		"producers": [
			{
				"binding": "QUEUE",
				"queue": "smart-links-data-queue-stage",
			},
		],
	},
	"workflows": [
		{
			"binding": "DESTINATION_EVALUATION_WORKFLOW",
			"name": "destination-evaluation-workflow",
			"class_name": "DestinationEvaluationWorkflow",
		},
	],
	"browser": {
		"binding": "VIRTUAL_BROWSER",
	},
	"ai": {
		"binding": "AI",
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "smart-links-eval-stage",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVALUATION_SCHEDULER_OBJECT",
				"class_name": "EvaluationSchedulerObject",
			},
			{
				"name": "LINK_CLICK_TRACKER_OBJECT",
				"class_name": "LinkClickTrackerObject",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["EvaluationSchedulerObject"],
		},
		{
			"tag": "V2",
			"new_sqlite_classes": ["LinkClickTrackerObject"],
		},
	],
}
