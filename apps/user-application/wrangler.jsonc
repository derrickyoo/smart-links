/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "stage": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "315348c9-1572-4014-927f-ab09722a5e54",
          "remote": true,
        },
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-stage",
          "remote": true,
        },
      ],
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["EvaluationSchedulerObject"],
        },
        {
          "tag": "V2",
          "new_sqlite_classes": ["LinkClickTrackerObject"],
        },
        {
          "tag": "V3",
          "deleted_classes": [
            "EvaluationSchedulerObject",
            "LinkClickTrackerObject",
          ],
        },
      ],
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "bed0e222-2445-4ec5-85ed-09ac62e5f82f",
        },
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-production",
        },
      ],
    },
  },
}
